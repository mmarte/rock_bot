# Copy this file to .env and fill in your real values
# NEVER commit .env to GitHub — it is already in .gitignore

# --- AI (required) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Facebook (required) ---
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_TOKEN=your_long_lived_page_access_token_here

# --- Images (required) ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- YouTube (optional but recommended) ---
# Free key: console.cloud.google.com → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=AIza_your_youtube_api_key_here

# --- Concerts + affiliate income (optional) ---
# Free key: developer.ticketmaster.com
# Affiliate ID: impactradius.com → search Ticketmaster → get your ID
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
TICKETMASTER_AFFILIATE_ID=your_affiliate_id_here

# --- Weekly email report (optional) ---
# Use a Gmail App Password (not your real password)
# Get one: myaccount.google.com → Security → App Passwords
REPORT_EMAIL=your@email.com
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
