# Copy this file to .env and fill in your real values
# NEVER commit .env to GitHub — it is in .gitignore

# ── AI Content (required) ──────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Facebook (required) ────────────────────────────────────────────────────
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_TOKEN=your_long_lived_page_access_token_here

# ── Images (required) ──────────────────────────────────────────────────────
# Free key at pexels.com/api — used for post images AND Reel footage
PEXELS_API_KEY=your_pexels_api_key_here

# ── YouTube Data API (search — optional) ──────────────────────────────────
# Used by find_video.py for post generation
YOUTUBE_API_KEY=AIza_your_youtube_api_key_here

# ── YouTube OAuth (Reel / Shorts upload — optional) ───────────────────────
# Get refresh token locally: delete youtube_token.json, then:
#   python make_reel.py --auth
# The script prints YOUTUBE_REFRESH_TOKEN; copy client id/secret from Google Cloud → Credentials
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token_from_make_reel_auth

# ── Concert affiliate (optional — Sunday posts) ────────────────────────────
# Ticketmaster key: developer.ticketmaster.com (free signup)
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
# Affiliate ID from FlexOffers (see setup instructions)
TICKETMASTER_AFFILIATE_ID=your_affiliate_id_here

# ── Reels voiceover (optional — daily Reels workflow) ─────────────────────
# Free tier: 10,000 chars/month at elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID — find at elevenlabs.io/voice-library (search Spanish voices)
# Default voice if left blank: Adam (works for Spanish)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── Weekly email report (optional) ────────────────────────────────────────
REPORT_EMAIL=your@email.com
SMTP_USER=your_gmail@gmail.com
# Gmail App Password (not your real password)
# Get one: myaccount.google.com → Security → 2-Step Verification → App Passwords
SMTP_PASSWORD=your_16_char_app_password_here

# ── Instagram cross-posting (optional) ────────────────────────────────────
# Your Instagram Business Account ID (not username)
# Find it: Graph API Explorer → /me/accounts → look for instagram_business_account id
IG_USER_ID=your_instagram_business_account_id_here

# ── Threads (optional) ─────────────────────────────────────────────────────
# Same ID as your Instagram Business Account
THREADS_USER_ID=17841432553146708
# Get Threads token: developers.facebook.com → your app → Threads API → Generate Token
THREADS_TOKEN=your_threads_access_token_here
